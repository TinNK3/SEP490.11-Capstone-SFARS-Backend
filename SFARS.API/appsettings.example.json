{
  "DatabaseProvider": "SqlServer",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://yourdomain.com"
  ],
  "HealthChecks": {
    "ApiBaseUrl": "http://localhost:5000/api"
  },
  "GoogleAuthSettings": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "EmailSettings": {
    "SmtpHost": "smtp-relay.brevo.com",
    "SmtpPort": 587,
    "SmtpCredential": {
      "UserName": "YOUR_SMTP_USERNAME",
      "Password": "YOUR_SMTP_PASSWORD"
    },
    "From": "YOUR_EMAIL@gmail.com",
    "FromName": "SFARS",
    "OtpSubject": "SFARS OTP Verification"
  },
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "Storage": {
    "MaxUploadBytes": 10485760,
    "IncidentMediaFolderFormat": "incidents/{0}/media",
    "AllowedImageTypes": [ "image/jpeg", "image/jpg", "image/png" ],
    "AllowedVideoTypes": [ "video/mp4", "video/quicktime", "video/x-msvideo" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "WebTokenSettings": {
    "ValidateIssuerSigningKey": true,
    "IssuerSigningKey": "YOUR_JWT_SECRET_KEY_MIN_64_CHARS",
    "ValidateIssuer": true,
    "ValidIssuer": "SFARS.API",
    "ValidateAudience": true,
    "ValidAudience": "SFARS.Client",
    "RequireExpirationTime": true,
    "ValidateLifetime": true,
    "TokenLifeTimeInMinutes": 60,
    "MaxRefreshTokenLifeSpan": 7,
    "RefreshTokenLifeTimeInMinutes": 10080,
    "RecoveryPasswordLifeTimeInMinutes": 15,
    "MfaTokenLifeTimeInMinutes": 5,
    "PaymentTokenLifeTimeInMinutes": 30
  }
}
