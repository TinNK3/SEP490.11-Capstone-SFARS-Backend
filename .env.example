# ============================================
# SFARS - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# WARNING: Never commit the .env file to git!
# Docker Compose automatically reads from .env
# ============================================

# ---- SQL Server ----
# Password must meet SQL Server complexity requirements:
# At least 8 characters, including uppercase, lowercase, digits, and symbols
SA_PASSWORD=YourStrong!Password123

# ---- Redis ----
REDIS_PASSWORD=YourRedisPassword123

# ---- JWT / Authentication ----
# Must be at least 64 characters for HMAC-SHA512
JWT_SIGNING_KEY=YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_64_CHARACTERS_LONG_REPLACE_THIS
JWT_TOKEN_LIFETIME=60
JWT_MAX_REFRESH_LIFESPAN=7
JWT_REFRESH_TOKEN_LIFETIME=10080

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Email / SMTP (Brevo) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@smtp-brevo.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=your-email@gmail.com

# ---- Cloudinary (Image Upload) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Gemini AI ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- PayOS (Payment Gateway) ----
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=https://yourdomain.com/payment/success
PAYOS_CANCEL_URL=https://yourdomain.com/payment/cancel
PAYOS_WEBHOOK_URL=https://yourdomain.com/api/webhooks/payos
PAYOS_ALLOW_SKIP_SIGNATURE=false

# ---- Payment ----
PAYMENT_TX_EXPIRE=30

# ---- Firebase (FCM Push Notifications) ----
# Place your firebase-adminsdk.json file in the project root
# It will be mounted into the container automatically
FIREBASE_PROJECT_ID=your-firebase-project-id
